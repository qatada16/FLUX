EXPO_PUBLIC_SUPABASE_URL=your-supabase-url-here
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
EXPO_PUBLIC_CEREBRAS_API_KEY=
EXPO_PUBLIC_MISTRAL_API_KEY=
EXPO_PUBLIC_GEMINI_API_KEY=
