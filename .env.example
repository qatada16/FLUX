# Release publishing only (scripts/release.mjs). Never prefix with EXPO_PUBLIC_ —
# that would bundle it into the app. Supabase → Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
